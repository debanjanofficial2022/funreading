# Browser (safe to expose): from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (set these in Vercel → Project → Settings → Environment Variables, never in the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Claude features are optional and off until you add a key (then redeploy):
#   ANTHROPIC_API_KEY turns on "Build rings with Claude".
#   QUIZZES=on also turns on quizzes.
# ANTHROPIC_API_KEY=sk-ant-...
# QUIZZES=on
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Daily Claude requests (rings + new quizzes), per reader and for the whole site
# AI_USER_DAILY_LIMIT=10
# AI_GLOBAL_DAILY_LIMIT=300
# Optional: identifies the site to Crossref's polite pool when reading DOIs from PDFs
CROSSREF_MAILTO=mailto:you@example.com
