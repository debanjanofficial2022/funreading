# Browser (safe to expose): from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (set these in Vercel → Project → Settings → Environment Variables, never in the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Quizzes are optional and off by default. To turn them on later, set both of these and redeploy:
# VITE_QUIZZES=true
# ANTHROPIC_API_KEY=sk-ant-...
# Optional quiz settings
# ANTHROPIC_MODEL=claude-sonnet-5-5
# QUIZ_USER_DAILY_LIMIT=10
# QUIZ_GLOBAL_DAILY_LIMIT=300
# Optional: identifies the site to Crossref's polite pool when reading DOIs from PDFs
CROSSREF_MAILTO=mailto:you@example.com
